# Copy to .env and set a strong, unique dashboard password before starting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional stable MCP bearer key. If omitted, a random key is generated and stored in CONFIG_PATH.
# MCP_API_KEY=

# Optional settings
# HOST_PORT=3000
# DOMAIN_NAME=mcp.example.com
# CORS_ORIGIN=https://your-mcp-client.example
# PH_ACCESS_TOKEN=your-product-hunt-access-token
# HF_BUCKET_URL=https://your-huggingface-bucket-endpoint
# HF_API_KEY=your-huggingface-token
